### set modifier
set $super Mod4
set $alt Mod1

### set font
font pango: Space Grotesk Regular 8

### Use mouse+$super to drag floating windows to their wanted position
floating_modifier $super

### autostart
exec --no-startup-id xsetroot -solid '#c0a9bb'
exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1 &
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=pkcs11 &
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=secrets &
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start --components=ssh &
exec --no-startup-id sleep 2 && mate-settings-daemon &
exec --no-startup-id sleep 2 && mate-power-manager &
exec --no-startup-id sleep 4 && synclient TapButton1=1 TapButton2=3 TapButton3=2 &

### start a terminal
bindsym $super+Return exec --no-startup-id i3-sensible-terminal

### start dmenu (a program launcher)
bindsym $super+d exec --no-startup-id i3-dmenu-desktop --dmenu="dmenu -i \
-fn 'Space Grotesk:size=9' -nb '#fcfbf9' -nf '#605a52' \
-sb '#477a7b' -sf '#fcfbf9'"

### common apps keybinds
#bindsym Print exec --no-startup-id scrot 'Cheese_%a-%d%b%y_%H.%M.png' -e 'xdg-open ~/$f'
bindsym Print exec --no-startup-id mate-screenshot
bindsym $super+l exec --no-startup-id i3lock -c '#d0c0d0'
bindsym $super+w exec --no-startup-id xdg-open about:home
bindsym $super+e exec --no-startup-id xdg-open ~

