Mpv|mpv|Vlc|vlc|File-roller|Xarchiver|Engrampa] floating enable
for_window [class=Eog|eog|Eom|eom|Sxiv|sxiv|Nsxiv|nsxiv|Feh|feh|\
Mpv|mpv|Vlc|vlc|File-roller|Xarchiver|Engrampa] focus
for_window [class=".*"] border pixel 8
hide_edge_borders smart
gaps inner 8
smart_gaps on
