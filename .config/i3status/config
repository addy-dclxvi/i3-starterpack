general {
	output_format = "i3bar"
	colors = false
	markup = pango
	interval = 2
}

order += "load"
order += "cpu_temperature 0"
order += "wireless _first_"
order += "volume master"
order += "battery 0"
order += "time"

load {
	format = "<span foreground='#1a1a1a' background='#b08500'>  Load  </span><span background='#3d3d3d'>  %5min  </span>"
}

cpu_temperature 0 {
	format = "<span foreground='#1a1a1a' background='#d12f2c'>  Temp  </span><span background='#3d3d3d'>  %degrees °C  </span>"
	path = "/sys/class/thermal/thermal_zone0/temp"
}

wireless _first_ {
	format_up = "<span foreground='#1a1a1a' background='#289c93'>  Wifi  </span><span background='#3d3d3d'>  %essid  </span>"
	format_down = "<span foreground='#1a1a1a' background='#289c93'>  Wifi  </span><span background='#3d3d3d'>  Off  </span>"
}

volume master {
	format = "<span foreground='#1a1a1a' background='#696ebf'>  Vol  </span><span background='#3d3d3d'>  %volume  </span>"
	format_muted = "<span foreground='#1a1a1a' background='#696ebf'>  Muted  </span><span background='#3d3d3d'>  %volume  </span>"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}

battery 0 {
	last_full_capacity = true
	format = "<span foreground='#1a1a1a' background='#819400'>  %status  </span><span background='#3d3d3d'>  %percentage  </span>"
	format_down = "No Battery"
	status_chr = "Charging"
	status_bat = "Battery"
	status_unk = "Unknown"
	status_full = "Full"
	path = "/sys/class/power_supply/BAT%d/uevent"
	low_threshold = 10
	integer_battery_capacity = true
	last_full_capacity = true
}

time {
	format = "<span foreground='#1a1a1a' background='#2587cc'>  %a %e %b  </span><span background='#3d3d3d'>  at %H:%M  </span>"
}

