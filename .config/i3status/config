general {
	output_format = "i3bar"
	colors = false
	markup = pango
	interval = 5
}

order += "load"
order += "cpu_temperature 0"
order += "wireless _first_"
order += "volume master"
order += "battery 0"
order += "time"

load {
	format = "<span background='#df8e1d'>  Load  </span><span background='#ccd0da'> <span foreground='#4c4f69'> %5min  </span></span>"
}

cpu_temperature 0 {
	format = "<span background='#d20f39'>  Temp  </span><span background='#ccd0da'> <span foreground='#4c4f69'> %degrees °C  </span></span>"
	path = "/sys/class/thermal/thermal_zone0/temp"
}

wireless _first_ {
	format_up = "<span background='#179299'>  Wifi  </span><span background='#ccd0da'> <span foreground='#4c4f69'> %essid  </span></span>"
	format_down = "<span background='#179299'>  Wifi  </span><span background='#ccd0da'> <span foreground='#4c4f69'> Off  </span></span>"
}

volume master {
	format = "<span background='#ea76cb'>  Vol  </span><span background='#ccd0da'> <span foreground='#4c4f69'> %volume  </span></span>"
	format_muted = "<span background='#ea76cb'>  Muted  </span><span background='#ccd0da'> <span foreground='#4c4f69'> %volume  </span></span>"
	device = "default"
	mixer = "Master"
	mixer_idx = 0
}

battery 0 {
	last_full_capacity = true
	format = "<span background='#40a02b'>  %status  </span><span background='#ccd0da'> <span foreground='#4c4f69'> %percentage  </span></span>"
	format_down = "No Battery"
	status_chr = "Charging"
	status_bat = "Battery"
	status_unk = "Unknown"
	status_full = "Full"
	path = "/sys/class/power_supply/BAT%d/uevent"
	low_threshold = 10
	integer_battery_capacity = true
}

time {
	format = "<span background='#1e66f5'>  %a %e %b  </span><span background='#ccd0da'> <span foreground='#4c4f69'> at %H:%M  </span></span>"
}

